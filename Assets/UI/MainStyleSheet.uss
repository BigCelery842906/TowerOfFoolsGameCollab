:root {
}

.unity-button {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-style: normal;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgb(77, 54, 7);
    transition-duration: 0.125s;
    transition-timing-function: ease-in-out;
    font-size: 28px;
    opacity: 1;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-image: url("project://database/Assets/UI/Assets/Button_Plate_Default.png?fileID=2800000&guid=27b24b6ddab20c74990f1897d4cd1288&type=3#Button_Plate_Default");
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: center 0;
    background-position-x: center 0;
    height: 100%;
    width: 100%;
    align-items: stretch;
    align-self: auto;
    align-content: stretch;
    justify-content: flex-start;
    min-height: auto;
    -unity-text-align: middle-center;
    background-size: contain;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Evil%20Empire.otf?fileID=12800000&guid=03fb5fe5b67ed9749bfee08dac9db391&type=3#Evil Empire");
    translate: 0 0;
    position: relative;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-button:hover {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-style: normal;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgb(77, 54, 7);
    transition-duration: 0.125s;
    transition-timing-function: ease-in-out-sine;
    font-size: 28px;
    opacity: 1;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    scale: 1.1 1.1;
    -unity-text-align: middle-center;
    text-overflow: clip;
    -unity-text-outline-width: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Evil%20Empire.otf?fileID=12800000&guid=03fb5fe5b67ed9749bfee08dac9db391&type=3#Evil Empire");
    -unity-background-image-tint-color: rgb(255, 241, 172);
    transition-property: all;
}

.credits-label {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Evil%20Empire.otf?fileID=12800000&guid=03fb5fe5b67ed9749bfee08dac9db391&type=3#Evil Empire");
    text-overflow: clip;
    white-space: pre-wrap;
    text-shadow: 0 2.8px 4.3px rgb(0, 0, 0);
}

.settings-dropdown .unity-base-popup-field__input {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Evil%20Empire.otf?fileID=12800000&guid=03fb5fe5b67ed9749bfee08dac9db391&type=3#Evil Empire");
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgb(210, 210, 210);
    background-image: url("project://database/Assets/UI/Assets/Settings/Drop%20down%20panel.png?fileID=21300000&guid=47bb9cf7e84db334b8cfd550fc8b5a0f&type=3#Drop down panel");
    border-width: 0;
    padding: 8px 16px;
}

.settings-dropdown .unity-base-popup-field__input > .unity-base-popup-field__text {
    color: white;
    -unity-text-align: middle-left;
}

.settings-dropdown .unity-base-popup-field__arrow {
    background-image: url("project://database/Assets/UI/Assets/Settings/dropdown-arrow-closed.png?fileID=21300000&guid=dcce4db5b8e3ee44bae425a47c0db4f5&type=3#dropdown-arrow-closed");
    -unity-background-scale-mode: scale-and-crop;
    width: 48px;
    height: 48px;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.settings-dropdown .unity-base-popup-field__input:hover {
    -unity-background-image-tint-color: rgb(180, 180, 180);
}

.settings-dropdown:focus .unity-base-popup-field__input:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}


.unity-base-dropdown__item > .unity-base-dropdown__label {
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Evil%20Empire.otf?fileID=12800000&guid=03fb5fe5b67ed9749bfee08dac9db391&type=3#Evil Empire");
}

.unity-base-dropdown__container-outer {
    background-image: url("project://database/Assets/UI/Assets/Settings/Background.png?fileID=21300000&guid=7db8c1754baf34141bd7ec7c1a13adb4&type=3#Background");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    /*--unity-9-slice-left: 80;*/
    /*--unity-9-slice-right: 80;*/
    /*--unity-9-slice-top: 80;*/
    /*--unity-9-slice-bottom: 80;*/
}

.unity-base-dropdown {
    background-image: none;
}

.unity-base-dropdown__item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-base-dropdown__item-content {
    padding: 8px 16px;
}

.unity-base-dropdown__item:hover {
    background-color: rgba(255, 200, 80, 0.15) !important;
}

.unity-base-dropdown__item:hover:enabled {
    background-color: rgba(255, 200, 80, 0.15);
}